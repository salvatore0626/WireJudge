{
  "_help": {
    "editing": "Edit numbers, save, then restart Wire Judge. Preserve key names. JSON does not support comments. Arrays with five values represent levels 1-5; upgrade price arrays represent purchases of levels 2-5.",
    "units": "Speeds: knots. Distances: NM. Times: simulated seconds. Fuel burn/refuel: units per second. Price/rewards: dollars. Fractions: 0.20 means 20%.",
    "endurance": "Mil endurance in hours = fuel_capacity / fuel_burn_units_per_second / 3600. KC-49 uses the same fuel pool for itself and transfers.",
    "enemy_aircraft": "Enemy entries override friendly entries of the same type. unlimited_fuel=true sets unlimited capacity and zero burn.",
    "loadouts": "Keep the existing weapon names and loadout labels; hardpoint_count/bay_count control rounds per slot. Default loadout arrays are trimmed/padded to configured slot counts.",
    "scope": "Game balance only; replay scoring is unchanged. Reload JSON by restarting the application.",
    "ground_missiles": "Ground unit range and missile launch_range_nm both limit launches. Missile max_range_nm controls travel. max_inflight_missiles and shot_interval_seconds control SAM/SAAW firing cadence.",
    "missile_drag": "With anti_radar_range_based_drag=true, HARM/Sidearm coast drag is calculated to reach max_range_nm. Set false to use their coast_deceleration_knots_per_second instead.",
    "enemy_reload": "Empty enemy weapon pools reload after reload_seconds. SAAW missiles/gun and each aircraft weapon type reload separately. Silo reload begins on launch, including while engagement is disabled.",
    "icbm": "Silo has unlimited engagement range and always knows the airfield position. ICBM acceleration is knots per simulated second; the default reaches 850 knots in 164 seconds.",
    "ground_units": "ground_units controls friendly units; enemy_ground_units is an independent copy for enemy units. min_engagement_range_nm controls firing/detection blind zones (0 disables the minimum); noncombat buildings only store this setting."
  },
